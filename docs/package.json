{
  "name": "pegline",
  "productName": "Pegline",
  "version": "1.5.0",
  "description": "晾晾 Pegline：截图、文件、文字自动挂在屏幕顶上的晾衣绳上，随时钉到屏幕",
  "main": "main.js",
  "author": "Tao Li",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac zip --arm64 --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "resedit": "^1.7.2"
  },
  "build": {
    "appId": "com.pegline.app",
    "productName": "Pegline",
    "copyright": "Pegline",
    "files": [
      "main.js",
      "preload.js",
      "common.js",
      "rope.html",
      "rope.js",
      "pin.html",
      "pin.js",
      "skins.css",
      "vendor/**",
      "build/tray.png",
      "build/tray@2x.png",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "build/icon.png",
      "samples/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "晾晾 Pegline",
      "artifactName": "Pegline-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Pegline-${version}-portable.exe"
    },
    "afterPack": "build/afterPack.js",
    "publish": null,
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "Pegline-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true,
        "CFBundleDisplayName": "Pegline",
        "NSHumanReadableCopyright": "Pegline"
      },
      "minimumSystemVersion": "11.0"
    }
  }
}